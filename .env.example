# Supabase project URL and publishable key (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Postgres transaction-pooler URL (Connect > Transaction pooler).
# Copy the actual URL from your dashboard. Keep certificate verification enabled.
DATABASE_URL=
# Optional announcement email delivery. EMAIL_FROM must be a verified sender.
RESEND_API_KEY=
EMAIL_FROM=
# Optional external scheduler authenticates POST /api/email-jobs with this secret.
EMAIL_JOB_SECRET=
